# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=paste-your-bot-token-here

# Spotify support (for /play with Spotify links). Free from
# https://developer.spotify.com/dashboard — create an app, copy both values.
# If left blank, YouTube / SoundCloud / Deezer still work.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: a test server (guild) ID for instant slash-command registration.
# Without this, global commands can take up to an hour to appear.
# Right-click your server in Discord (with Developer Mode on) -> Copy Server ID
GUILD_ID=
